# Copy to .env. No delivery happens while DELIVERY_ENABLED=false.
DATABASE_URL=postgresql://app:change-me@localhost:5432/automation?schema=public
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000
SITE_INDEXABLE=false
COMPANY_NAME=[FIRMENNAME]
COMPANY_OWNER=[NAME]
COMPANY_ADDRESS=[ADRESSE]
COMPANY_EMAIL=[E-MAIL]
COMPANY_PHONE=[TELEFON]
COMPANY_LEGAL_FORM=[RECHTSFORM]
COMPANY_VAT=[UST-ID]
COMPANY_REGISTER=[REGISTERDATEN]
COMPANY_PRIVACY=[DATENSCHUTZKONTAKT]
COMPANY_HOST=[HOSTER]
COMPANY_REGION=[REGION]
COMPANY_CRM=[CRM]
BOOKING_URL=
# Generate independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FORM_SECRET=
RATE_LIMIT_SECRET=
DELIVERY_ENABLED=false
RESEND_API_KEY=
MAIL_FROM=
MAIL_INTERNAL_TO=
N8N_WEBHOOK_URL=
N8N_SIGNING_SECRET=
# Only enable after reverse proxy overwrites X-Real-IP and blocks direct access.
TRUST_PROXY=false
RETENTION_DAYS=180
# Only in a dedicated disposable database, never in production.
ALLOW_DATABASE_TESTS=false

# Optional: separate local build directory; leave unset for the default .next.
# PROZESSWERK_BUILD_DIR=.next
# Docker sets BUILD_STANDALONE=true during its build.
