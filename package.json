{
  "name": "prozesswerk-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsc -p tsconfig.tests.json && node --test local-data/test-build/tests/security.test.js",
    "test:integration": "tsc -p tsconfig.tests.json && node --test local-data/test-build/tests/integration/backend.test.js",
    "test:e2e": "playwright test",
    "db:deploy": "prisma migrate deploy",
    "tools:build": "tsc -p tsconfig.tools.json",
    "admin:create": "npm run tools:build && node local-data/tool-build/scripts/create-admin.js",
    "worker": "npm run tools:build && node local-data/tool-build/scripts/worker.js",
    "retention": "npm run tools:build && node local-data/tool-build/scripts/retention.js",
    "launch:check": "npm run tools:build && node local-data/tool-build/scripts/launch-check.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "dotenv": "^18.0.8",
    "next": "15.5.28",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.6.0",
    "prisma": "6.19.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.2"
  },
  "overrides": {
    "postcss": "8.5.30",
    "deepmerge-ts": "8.0.2"
  }
}
